# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# TMDB API Read Access Token (v4 auth, "Bearer" token).
# Get one for free: https://www.themoviedb.org/settings/api
# Used only on the server; it is never sent to the browser.
TMDB_ACCESS_TOKEN=

# Port the HTTP server listens on (default: 3000).
PORT=3000
